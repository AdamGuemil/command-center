# Copie ce fichier en .env et remplis-le. Le CC le lit au demarrage (les vraies variables
# d'environnement passent devant). Sans aucune cle : CC_DEMO=1 lance la demo.

# --- Roblox -------------------------------------------------------------------------
# Identifiants publics de l'experience (Creator Hub > experience > ... > Copy Universe ID).
GAME_NAME=Shroud War
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=
ROBLOX_GAME_PLACE_ID=
ROBLOX_GAME_URL=

# Cle Open Cloud creee au nom du proprietaire de l'experience (groupe), sur cet univers.
# Droits requis : docs/OPERATIONS.md > « Cles a creer ». Verification : Sante > « Tester
# les permissions ». Une seule ligne, sans guillemets.
ROBLOX_OPENCLOUD_KEY=

# --- Discord ------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE=

# --- Serveur ------------------------------------------------------------------------
CC_HOST=127.0.0.1
CC_PORT=8787
# 0 pour ne pas ouvrir le navigateur au demarrage (conteneur, serveur distant).
CC_OPEN_BROWSER=1
# 1 : faux univers et faux Discord, aucune cle, donnees dans data/demo/.
CC_DEMO=0

# --- Lien avec le depot du jeu (facultatif) -----------------------------------------
# Dossier qui contient HUB/ et GAME/ : version des donnees lue dans SharedConfig.luau et
# guides du jeu dans l'ecran Guide. Sinon, CC_DATASTORE_VERSION fixe la version a la main.
CC_GAME_ROOT=
CC_DATASTORE_VERSION=
