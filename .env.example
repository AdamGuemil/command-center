# Copie ce fichier en .env et remplis-le. Le CC le lit au demarrage (les vraies variables
# d'environnement passent devant).

# --- Roblox -------------------------------------------------------------------------
# Identifiants publics de l'experience (Creator Hub > experience > ... > Copy Universe ID).
GAME_NAME=Shroud War
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=
ROBLOX_GAME_PLACE_ID=
ROBLOX_GAME_URL=

# Cle Open Cloud creee au nom du proprietaire de l'experience (groupe), sur cet univers.
# Droits requis : docs/OPERATIONS.md > « Cles a creer ». Verification : Sante > « Tester
# les permissions ». Une seule ligne, sans guillemets.
ROBLOX_OPENCLOUD_KEY=

# --- Discord ------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE=

# --- Serveur ------------------------------------------------------------------------
CC_HOST=127.0.0.1
CC_PORT=8787
# 0 pour ne pas ouvrir le navigateur au demarrage (conteneur, serveur distant).
CC_OPEN_BROWSER=1
# 1 : le bot Discord (tickets, journaux, roles, liaison Roblox) tourne dans le meme processus.
# Il lit data/bot_data.json, ecrit une fois par tools/setup_discord.py.
CC_BOT=0

# --- Lien avec le depot du jeu (facultatif) -----------------------------------------
# Dossier qui contient HUB/ et GAME/ : version des donnees lue dans SharedConfig.luau et
# guides du jeu dans l'ecran Guide. Sinon, CC_DATASTORE_VERSION fixe la version a la main.
CC_GAME_ROOT=
CC_DATASTORE_VERSION=

# --- Heberge (lot 6) : console en ligne, connexion Discord ----------------------------
# Laisse vide sur ton PC : sans DISCORD_CLIENT_ID/SECRET, le CC reste en mode local (sans
# connexion) et refuse d'ecouter ailleurs que sur 127.0.0.1.
# Discord Developer Portal > ton application > OAuth2 : Client ID et Client Secret, et dans
# « Redirects » l'adresse exacte <CC_PUBLIC_URL>/auth/callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Adresse publique de la console, en https, sans / final (ex. https://cc.mondomaine.fr).
CC_PUBLIC_URL=
# Domaine seul, pour Caddy (docker-compose.yml) : son DNS doit pointer sur le serveur.
CC_DOMAIN=
# Identifiants Discord (clic droit sur un membre > Copier l'identifiant ; mode developpeur
# active), separes par des virgules. Admins : tout. Modos : lire, message, kick. Lecteurs : lire.
CC_ADMINS=
CC_MODS=
CC_VIEWERS=
# Duree d'une session sans visite avant reconnexion, en jours.
CC_SESSION_DAYS=30

# Webhooks Roblox (Creator Hub > Webhooks) : URL <CC_PUBLIC_URL>/webhooks/roblox, et ce
# meme secret dans le champ « Secret ». Vide : la route repond 404.
ROBLOX_WEBHOOK_SECRET=

# Sauvegarde quotidienne de data/cc.db (copies gardees).
CC_BACKUP_KEEP=14
